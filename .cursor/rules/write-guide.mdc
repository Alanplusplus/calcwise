    type: "article",
  },
};

const faqs = [
  { question: "...", answer: "..." },
  { question: "...", answer: "..." },
  { question: "...", answer: "..." },
];

export default function GuidePage() {
  return (
    <div className="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <FaqJsonLd faqs={faqs} />

